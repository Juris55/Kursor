{
  "name": "kursor",
  "version": "2.0.0",
  "description": "Kursor - Latviešu teksta redaktors ar AI atbalstu",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win --x64",
    "electron:build:win:arm": "vite build && electron-builder --win --arm64",
    "electron:build:win:x86": "vite build && electron-builder --win --ia32",
    "electron:build:win:all": "vite build && electron-builder --win --x64 --arm64 --ia32",
    "electron:build:mac": "vite build && electron-builder --mac --x64",
    "electron:build:mac:arm": "vite build && electron-builder --mac --arm64",
    "electron:build:mac:all": "vite build && electron-builder --mac --x64 --arm64",
    "electron:build:linux": "vite build && electron-builder --linux --x64",
    "electron:build:linux:arm": "vite build && electron-builder --linux --arm64",
    "electron:build:linux:all": "vite build && electron-builder --linux --x64 --arm64",
    "electron:build:all": "vite build && electron-builder --win --x64 --arm64 --ia32 --mac --x64 --arm64 --linux --x64 --arm64",
    "start": "npm run electron:dev",
    "dist": "npm run electron:build:win",
    "dist:mac": "npm run electron:build:mac",
    "dist:linux": "npm run electron:build:linux"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "https-proxy-agent": "^9.0.0",
    "i18next": "^23.11.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "socks-proxy-agent": "^10.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "lv.kursor.app",
    "productName": "Kursor",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64", "arm64", "ia32"]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "deb",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "build/icons",
      "category": "Office",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kursor"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
